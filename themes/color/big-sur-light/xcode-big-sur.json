  "tokenColors": [
    {
      "name": "Comment",
      "scope": "comment",
      "settings": {
        "foreground": "#89c0b4"
      }
    },
    {
      "name": "Preprocessor Statements",
      "scope": [
        "meta.preprocessor",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#ef8776"
      }
    },
    {
      "name": "String",
      "scope": "string",
      "settings": {
        "foreground": "#ee81b0"
      }
    },
    {
      "name": "Number",
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#8adcfb"
      }
    },
    {
      "name": "Built-in constant",
      "scope": "constant.language",
      "settings": {
        "foreground": "#ee81b0"
      }
    },
    {
      "name": "User-defined constant",
      "scope": [
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#89c0b4"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable.language",
        "variable.other"
      ],
      "settings": {
        "foreground": "#ee81b0"
      }
    },
    {
      "name": "Keyword",
      "scope": "keyword",
      "settings": {
        "foreground": "#ee81b0"
      }
    },
    {
      "name": "Storage",
      "scope": "storage",
      "settings": {
        "foreground": "#ee81b0"
      }
    },
    {
      "name": "Class name",
      "scope": "entity.name.class",
      "settings": {
        "foreground": "#89c0b4"
      }
    },
    {
      "name": "Markup bold",
      "scope":  [
        "markup.bold",
        "markdown.bold",
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#89c0b4"
      }
    },
    {
      "name": "Markup heading",
      "scope":  [
        "markup.heading",
        "markdown.heading",
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#89c0b4"
      }
    },
    {
      "name": "Markup italic",
      "scope":  [
        "markup.italic",
        "markdown.italic",
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#ee81b0"
      }
    },
    {
      "name": "Markup quote",
      "scope":  [
        "markup.quote",
        "markdown.quote",
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#ee81b0"
      }
    },
    {
      "name": "Inherited class",
      "scope": "entity.other.inherited-class",
      "settings": {}
    },
    {
      "name": "Function name",
      "scope": "entity.name.function",
      "settings": {}
    },
    {
      "name": "Function argument",
      "scope": "variable.parameter",
      "settings": {}
    },
    {
      "name": "Tag name",
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#aa83e4"
      }
    },
    {
      "name": "Tag attribute",
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#aa83e4"
      }
    },
    {
      "name": "Library function",
      "scope": "support.function",
      "settings": {
        "foreground": "#aa83e4"
      }
    },
    {
      "name": "Library constant",
      "scope": "support.constant",
      "settings": {
        "foreground": "#aa83e4"
      }
    },
    {
      "name": "Library class/type",
      "scope": [
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#aa83e4"
      }
    },
    {
      "name": "Library variable",
      "scope": "support.other.variable",
      "settings": {
        "foreground": "#aa83e4"
      }
    },
    {
      "name": "Invalid",
      "scope": "invalid",
      "settings": {}
    },
    {
      "scope": "token.info-token",
      "settings": {
        "foreground": "#8adcfb"
      }
    },
    {
      "scope": "token.warn-token",
      "settings": {
        "foreground": "#d5c985"
      }
    },
    {
      "scope": "token.error-token",
      "settings": {
        "foreground": "#ee81b0"
      }
    },
    {
      "scope": "token.debug-token",
      "settings": {
        "foreground": "#aa83e4"
      }
    }
  ]
}